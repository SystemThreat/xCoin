{
  "manifest_version": 3,
  "name": "NerdMiner MD",
  "version": "1.2.0",
  "description": "Live stats from your NerdMiner rig, who's online at MineDifferent, and the #rigs chat. No mining in the browser.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "NerdMiner MD",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://minedifferent.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "nerdminer-md@minedifferent.com",
      "strict_min_version": "127.0"
    }
  }
}
